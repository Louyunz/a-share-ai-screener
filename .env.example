# A 股 AI 选股助手环境变量示例
# 复制为 .env 后按需修改（.env 已在 .gitignore 中忽略）

# 真实模型（OpenAI 兼容接口；缺失时服务启动失败）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 数据与回测
DATA_DIR=./data
DEFAULT_TOP_N=10
BACKTEST_YEARS=2
REBALANCE_DAYS=20
COST_BUY=0.0003
COST_SELL=0.0013
RISK_FREE_RATE=0.02

# Tushare（可选，仅 build_cache --source tushare 时需要）
TUSHARE_TOKEN=
# 管理员登录（留空则在首次打开页面时创建管理员）
# 生成哈希：.venv\Scripts\python.exe scripts\set_password.py
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_HOURS=12
# HTTPS 部署时改为 1
AUTH_COOKIE_SECURE=0
# 每日行情同步（工作日收盘后）
DATA_SYNC_ENABLED=1
DATA_SYNC_HOUR=18
DATA_SYNC_MINUTE=5
DATA_SYNC_SOURCE=tushare
DATA_SYNC_TIMEZONE=Asia/Shanghai
