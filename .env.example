# A 股 AI 选股 MVP 环境变量示例
# 复制为 .env 后按需修改（.env 已在 .gitignore 中忽略）

# LLM（OpenAI 兼容接口，必填；缺失时服务启动失败）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 仅本地 UI 联调：fake 使用确定性假模型，不需要 Key（生产/演示必须用真实模型）
# LLM_PROVIDER=openai

# 数据
DATA_DIR=./data
DEFAULT_TOP_N=10
DEFAULT_TRIALS=24
BACKTEST_YEARS=2
REBALANCE_DAYS=20
COST_BUY=0.0003
COST_SELL=0.0013
RISK_FREE_RATE=0.02

# Tushare（可选，仅 build_cache --source tushare 时需要）
TUSHARE_TOKEN=
